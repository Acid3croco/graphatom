# Config de déploiement de cette instance, épinglée dans le repo.
#
# `docker compose` lit ce fichier tout seul : un redéploiement (`docker
# compose up -d`) ne dépend donc plus des variables du shell qui l'invoque.
# Aucun secret ici — GITHUB_TOKEN reste fourni par le shell.

GRAPHATOM_TAKE_ALL=1
GRAPHATOM_ANSWERERS=Acid3croco
GRAPHATOM_WEB_URL=https://graphatom.veyxzer.com

# L'UI est exposée derrière le Traefik de l'hôte : le service web rejoint le
# réseau du proxy, créé hors de ce compose (d'où `EXTERNAL=true`). Un autre
# déploiement laisse ces deux lignes de côté et garde les défauts du compose.
GRAPHATOM_PROXY_NET=coolify
GRAPHATOM_PROXY_NET_EXTERNAL=true
